{
    "name": "web-snaps",
    "version": "2.1.0",
    "description": "Browser automation with automatic snapshotting.",
    "keywords": [
        "snapshots",
        "browser",
        "automation",
        "playwright"
    ],
    "homepage": "https://github.com/electrovir/web-snaps",
    "bugs": {
        "url": "https://github.com/electrovir/web-snaps/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/web-snaps.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "test-as-package virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.68.2",
        "@augment-vir/common": "^31.68.2",
        "@augment-vir/web": "^31.68.2",
        "date-vir": "^8.2.1",
        "rebrowser-playwright": "^1.52.0",
        "sanitize-filename": "^1.6.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.68.2",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^25.5.0",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "cspell": "^9.7.0",
        "dependency-cruiser": "^17.3.10",
        "esbuild": "^0.27.4",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.8.1",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.1",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.0.2",
        "eslint-plugin-unicorn": "^64.0.0",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^19.6.6",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.0",
        "prettier-plugin-multiline-arrays": "^4.1.5",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.0",
        "test-as-package": "^2.0.4",
        "type-fest": "^5.5.0",
        "typedoc": "^0.28.18",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1",
        "virmator": "^14.10.3"
    },
    "engines": {
        "node": ">=22"
    }
}
