{
    "name": "web-snaps",
    "version": "3.2.1",
    "description": "Browser automation with automatic snapshotting.",
    "keywords": [
        "snapshots",
        "browser",
        "automation",
        "playwright"
    ],
    "homepage": "https://github.com/electrovir/web-snaps",
    "bugs": {
        "url": "https://github.com/electrovir/web-snaps/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/web-snaps.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "test-as-package virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "overrides": {
        "@playwright/test": "^1.61.1",
        "playwright": "npm:@electrovir/rebrowser-playwright@^1.61.1",
        "playwright-core": "npm:@electrovir/rebrowser-playwright-core@^1.61.1"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/web": "^32.2.1",
        "date-vir": "^8.6.2",
        "sanitize-filename": "^1.6.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.2.1",
        "@electrovir/rebrowser-playwright": "^1.61.101",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^22.2.9",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.6",
        "test-as-package": "^2.0.4",
        "tsx": "^4.23.1",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.2"
    },
    "peerDependencies": {
        "@electrovir/rebrowser-playwright": ">=1.61.1"
    },
    "engines": {
        "node": ">=22"
    }
}
